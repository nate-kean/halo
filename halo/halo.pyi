from typing import Any, Callable, Dict, Optional, TextIO, Tuple, TypeVar, Union

SpinnerFrame = Dict[str, Any]
SpinnerType = Union[str, SpinnerFrame]
T = TypeVar("T")

class Halo(object):
    CLEAR_LINE: str
    SPINNER_PLACEMENTS: Tuple[str, str]

    def __init__(
        self,
        text: str = ...,
        color: str = ...,
        text_color: Optional[str] = ...,
        spinner: Optional[SpinnerType] = ...,
        animation: Optional[str] = ...,
        placement: str = ...,
        interval: float = ...,
        enabled: bool = ...,
        stream: TextIO = ...,
    ) -> None: ...
    def __enter__(self) -> Halo: ...
    def __exit__(
        self,
        type: Optional[type],
        value: Optional[BaseException],
        traceback: Optional[Any],
    ) -> None: ...
    def __call__(self, f: Callable[..., T]) -> Callable[..., T]: ...

    @property
    def spinner(self) -> SpinnerFrame: ...
    @spinner.setter
    def spinner(self, spinner: Optional[SpinnerType]) -> None: ...

    @property
    def text(self) -> str: ...
    @text.setter
    def text(self, text: str) -> None: ...

    @property
    def text_color(self) -> Optional[str]: ...
    @text_color.setter
    def text_color(self, text_color: Optional[str]) -> None: ...

    @property
    def color(self) -> str: ...
    @color.setter
    def color(self, color: str) -> None: ...

    @property
    def placement(self) -> str: ...
    @placement.setter
    def placement(self, placement: str) -> None: ...

    @property
    def spinner_id(self) -> Optional[str]: ...

    @property
    def animation(self) -> Optional[str]: ...
    @animation.setter
    def animation(self, animation: Optional[str]) -> None: ...

    def clear(self) -> Halo: ...
    def render(self) -> Halo: ...
    def frame(self) -> str: ...
    def text_frame(self) -> str: ...
    def start(self, text: Optional[str] = ...) -> Halo: ...
    def stop(self) -> Halo: ...
    def succeed(self, text: Optional[str] = ...) -> Halo: ...
    def fail(self, text: Optional[str] = ...) -> Halo: ...
    def warn(self, text: Optional[str] = ...) -> Halo: ...
    def info(self, text: Optional[str] = ...) -> Halo: ...
    def stop_and_persist(self, symbol: str = ..., text: Optional[str] = ...) -> Halo: ...
